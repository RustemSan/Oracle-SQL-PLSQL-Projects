SQL> -- ------------------------------------------------------------------
SQL> -- IO 1: Trigger to prevent pilot flight time overlapping
SQL> -- ------------------------------------------------------------------
SQL> 
SQL> 
SQL> CREATE OR REPLACE TRIGGER trg_pilot_flight_overlap
  2  FOR INSERT OR UPDATE ON pilot_flight
  3  COMPOUND TRIGGER
  4  
  5  	 -- Collection to store existing flight schedules
  6  	 TYPE t_schedule_rec IS RECORD
  7  				 (
  8  				 id_employee NUMBER,
  9  				 start_t TIMESTAMP,
 10  				 end_t TIMESTAMP
 11  				);
 12  	 TYPE t_schedule_tab IS TABLE OF t_schedule_rec;
 13  	 v_schedules t_schedule_tab;
 14  
 15  	 BEFORE STATEMENT IS
 16  	 BEGIN
 17  	     SELECT pf.id_employee, f.departure_time, f.arrival_time
 18  	     BULK COLLECT INTO v_schedules
 19  	     FROM pilot_flight pf
 20  	     JOIN flight f ON pf.id_flight = f.id_flight;
 21  	 END BEFORE STATEMENT;
 22  
 23  	 -- Step 2: Check each new row against the loaded schedules
 24  	 AFTER EACH ROW IS
 25  	     v_new_start TIMESTAMP;
 26  	     v_new_end	 TIMESTAMP;
 27  	 BEGIN
 28  	     -- Get times for the current inserting/updating flight
 29  	     SELECT departure_time, arrival_time INTO v_new_start, v_new_end
 30  	     FROM flight WHERE id_flight = :NEW.id_flight;
 31  
 32  	     FOR i IN 1 .. v_schedules.COUNT LOOP
 33  		 -- Check only for the same pilot, excluding the current record itself if updating
 34  		 IF v_schedules(i).id_employee = :NEW.id_employee THEN
 35  		     IF (v_new_start < v_schedules(i).end_t AND v_new_end > v_schedules(i).start_t) THEN
 36  			 RAISE_APPLICATION_ERROR(-20001, 'IO Violation: Pilot ID ' || :NEW.id_employee || ' has an overlapping flight.');
 37  		     END IF;
 38  		 END IF;
 39  	     END LOOP;
 40  	 END AFTER EACH ROW;
 41  
 42  
 43  
 44  END trg_pilot_flight_overlap;
 45  /

Trigger created.

