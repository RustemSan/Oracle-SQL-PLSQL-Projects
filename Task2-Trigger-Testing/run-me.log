SQL> -- ------------------------------------------------------------------
SQL> -- IO 2: Trigger to prevent overselling tickets (Aircraft Capacity)
SQL> -- Implementation based on Lecture Section 9.4
SQL> -- ------------------------------------------------------------------
SQL> CREATE OR REPLACE TRIGGER trg_ticket_capacity
  2  FOR INSERT ON ticket
  3  COMPOUND TRIGGER
  4  
  5  	 TYPE t_count_tab IS TABLE OF NUMBER INDEX BY PLS_INTEGER;
  6  	 v_ticket_counts t_count_tab;
  7  
  8  	 -- Step 1: Count current tickets for all flights
  9  	 BEFORE STATEMENT IS
 10  	 BEGIN
 11  	     FOR r IN (SELECT id_flight, COUNT(*) as cnt FROM ticket GROUP BY id_flight) LOOP
 12  		 v_ticket_counts(r.id_flight) := r.cnt;
 13  	     END LOOP;
 14  	 END BEFORE STATEMENT;
 15  
 16  	 -- Step 2: Check capacity for each new ticket
 17  	 BEFORE EACH ROW IS
 18  	     v_capacity NUMBER;
 19  	     v_current	NUMBER := 0;
 20  	 BEGIN
 21  	     -- Get plane capacity for this flight
 22  	     SELECT p.capacity INTO v_capacity
 23  	     FROM flight f
 24  	     JOIN plane p ON f.id_plane = p.id_plane
 25  	     WHERE f.id_flight = :NEW.id_flight;
 26  
 27  	     IF v_ticket_counts.EXISTS(:NEW.id_flight) THEN
 28  		 v_current := v_ticket_counts(:NEW.id_flight);
 29  	     END IF;
 30  
 31  	     IF v_current >= v_capacity THEN
 32  		 RAISE_APPLICATION_ERROR(-20002, 'IO Violation: Flight ' || :NEW.id_flight || ' is full (Capacity: ' || v_capacity || ').');
 33  	     END IF;
 34  
 35  	     -- Update internal counter for the next row in same statement
 36  	     v_ticket_counts(:NEW.id_flight) := v_current + 1;
 37  	 END BEFORE EACH ROW;
 38  END trg_ticket_capacity;
 39  /

Trigger created.

